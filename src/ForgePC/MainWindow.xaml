<Window x:Class="ForgePC.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ForgePC" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="EZoptimizer" Icon="app.ico" Width="1280" Height="900" MinWidth="640" MinHeight="360" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" UseLayoutRounding="True">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <ResourceDictionary>
      <local:NavigationTemplateSelector x:Key="NavigationTemplate" xmlns:local="clr-namespace:ForgePC" />
      <DataTemplate x:Key="Page-Overview">
        <StackPanel Tag="Page-Overview" DataContext="{Binding DataContext,RelativeSource={RelativeSource AncestorType=Window}}">
          <Border Style="{StaticResource Card}" Padding="26,22" Background="{DynamicResource Raised}">
            <local:AdaptivePanel MaxColumns="2" MinimumItemWidth="285" Gap="28">
              <StackPanel>
                <TextBlock Text="A SETUP THAT FITS YOU" Style="{StaticResource Eyebrow}" Foreground="{DynamicResource Accent}" Margin="0,0,0,6"/>
                <TextBlock Text="Your PC. Your pace." FontSize="32" LineHeight="42" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock Text="Choose your focus. Review every change." Style="{StaticResource MutedText}" Margin="0,0,0,16"/>
                <Button Content="Find your profile  →" Command="{Binding Navigate}" CommandParameter="Profiles" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0"/>
              </StackPanel>
              <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="20" Background="{DynamicResource Canvas}">
                <StackPanel>
                  <DockPanel><TextBlock Text="&#xE73E;" Style="{StaticResource Glyph}" Foreground="{DynamicResource Accent}" DockPanel.Dock="Right"/><TextBlock Text="CURRENT SESSION" Style="{StaticResource Eyebrow}"/></DockPanel>
                  <TextBlock Text="{Binding ActiveProfile}" FontSize="18" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding RecoverySummary}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,4"/>
                  <Button Content="View recovery  ↗" Command="{Binding Navigate}" CommandParameter="Recovery &amp; History" Style="{StaticResource Ghost}" HorizontalAlignment="Left" Padding="0,6" Margin="0" MinHeight="24"/>
                </StackPanel>
              </Border>
            </local:AdaptivePanel>
          </Border>
          <DockPanel Margin="0,6,0,12"><TextBlock Text="System at a glance" Style="{StaticResource Heading}" Margin="0"/><TextBlock Text="{Binding Stamp}" Style="{StaticResource MutedText}" FontSize="10" TextAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0"/></DockPanel>
          <local:AdaptivePanel MaxColumns="3" MinimumItemWidth="190" Gap="14" Margin="0,0,0,22">
            <Border Style="{StaticResource Card}" Margin="0" Padding="20,16">
              <StackPanel>
                <DockPanel><TextBlock Text="&#xE950;" Style="{StaticResource Glyph}" Foreground="{DynamicResource Muted}" DockPanel.Dock="Right"/><TextBlock Text="Processor" Style="{StaticResource MutedText}" Margin="0"/></DockPanel>
                <TextBlock Text="{Binding Cpu}" Style="{StaticResource MetricValue}"/>
                <TextBlock Text="CPU utilization" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,12"/>
                <ProgressBar Value="{Binding CpuLevel,Mode=OneWay}" Maximum="100" Height="4" AutomationProperties.Name="CPU utilization"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0" Padding="20,16">
              <StackPanel>
                <DockPanel><TextBlock Text="&#xE964;" Style="{StaticResource Glyph}" Foreground="{DynamicResource Muted}" DockPanel.Dock="Right"/><TextBlock Text="Memory" Style="{StaticResource MutedText}" Margin="0"/></DockPanel>
                <TextBlock Text="{Binding Memory}" Style="{StaticResource MetricValue}"/>
                <TextBlock Text="Physical memory in use" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,12"/>
                <ProgressBar Value="{Binding MemoryLevel,Mode=OneWay}" Maximum="100" Height="4" AutomationProperties.Name="Memory utilization"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0" Padding="20,16">
              <StackPanel>
                <DockPanel><TextBlock Text="&#xEDA2;" Style="{StaticResource Glyph}" Foreground="{DynamicResource Muted}" DockPanel.Dock="Right"/><TextBlock Text="Storage" Style="{StaticResource MutedText}" Margin="0"/></DockPanel>
                <TextBlock Text="{Binding Disk}" Style="{StaticResource MetricValue}"/>
                <TextBlock Text="Available on your system drive" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,12"/>
                <ProgressBar Value="{Binding DiskUsedLevel,Mode=OneWay}" Maximum="100" Height="4" AutomationProperties.Name="System drive space used"/>
              </StackPanel>
            </Border>
          </local:AdaptivePanel>
          <DockPanel Margin="0,0,0,10"><Button DockPanel.Dock="Right" Content="All profiles  →" Command="{Binding Navigate}" CommandParameter="Profiles" Style="{StaticResource Ghost}" Padding="8,0" MinHeight="24" Margin="0"/><TextBlock Text="What are you here for?" Style="{StaticResource Heading}" Margin="0"/></DockPanel>
          <ItemsControl ItemsSource="{Binding QuickProfiles}" Margin="0,0,0,22">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><local:AdaptivePanel MinimumItemWidth="190" MaxColumns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate>
              <Button Command="{Binding DataContext.ChooseProfile,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Background="{DynamicResource Surface}" HorizontalContentAlignment="Stretch" Padding="18" Margin="0" AutomationProperties.Name="{Binding}">
                <StackPanel><DockPanel><TextBlock DockPanel.Dock="Right" Text="↗" Foreground="{DynamicResource Muted}" Margin="0"/><TextBlock Text="{Binding Converter={StaticResource Presentation},ConverterParameter=Glyph}" Style="{StaticResource Glyph}" Foreground="{DynamicResource Accent}" Margin="0,0,0,12"/></DockPanel><TextBlock Text="{Binding}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"/><TextBlock Text="{Binding Converter={StaticResource Presentation},ConverterParameter=ProfileDescription}" Style="{StaticResource MutedText}" FontSize="11" FontWeight="Normal" Margin="0"/></StackPanel>
              </Button>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border Style="{StaticResource Card}" Padding="20,16">
            <StackPanel>
              <DockPanel><TextBlock Text="Your hardware" Style="{StaticResource Heading}" Margin="0,0,0,14"/><TextBlock Text="LOCAL INVENTORY" Style="{StaticResource Eyebrow}" TextAlignment="Right" Margin="0"/></DockPanel>
              <local:AdaptivePanel MaxColumns="2" MinimumItemWidth="250" Gap="20">
                <StackPanel><TextBlock Text="PROCESSOR" Style="{StaticResource Eyebrow}" Margin="0,0,0,4"/><TextBlock Text="{Binding CpuModel}" Margin="0" FontSize="12"/></StackPanel>
                <StackPanel><TextBlock Text="GRAPHICS" Style="{StaticResource Eyebrow}" Margin="0,0,0,4"/><TextBlock Text="{Binding GpuModel}" Margin="0" FontSize="12"/></StackPanel>
              </local:AdaptivePanel>
              <Expander Header="Full system details" Margin="0,8,0,0"><TextBlock Text="{Binding Hardware}" Style="{StaticResource MutedText}" FontSize="12"/></Expander>
              <Expander Header="Recent activity">
                <local:AdaptivePanel MaxColumns="2" MinimumItemWidth="220">
                  <StackPanel><TextBlock Text="CPU · recent samples" Style="{StaticResource MutedText}" FontSize="12"/><Polyline Points="{Binding CpuPoints}" Stroke="{DynamicResource Accent}" StrokeThickness="2" Height="44" Width="200" Stretch="None" HorizontalAlignment="Left" AutomationProperties.Name="Recent sampled CPU activity"/></StackPanel>
                  <StackPanel><TextBlock Text="Memory · recent samples" Style="{StaticResource MutedText}" FontSize="12"/><Polyline Points="{Binding MemoryPoints}" Stroke="{DynamicResource Accent}" StrokeThickness="2" Height="44" Width="200" Stretch="None" HorizontalAlignment="Left" AutomationProperties.Name="Recent sampled memory activity"/></StackPanel>
                </local:AdaptivePanel>
              </Expander>
            </StackPanel>
          </Border>
        </StackPanel>
      </DataTemplate>
      <DataTemplate x:Key="Page-Recommendations">
        <StackPanel Tag="Page-Recommendations" DataContext="{Binding DataContext,RelativeSource={RelativeSource AncestorType=Window}}">
          <TextBlock Text="DETECTED ON THIS PC" Style="{StaticResource Eyebrow}" />
          <ItemsControl ItemsSource="{Binding Recommendations}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Heading}" />
                    <TextBlock Text="{Binding Detected}" Foreground="{DynamicResource Accent}" />
                    <TextBlock Text="{Binding Reason}" />
                    <TextBlock Text="{Binding Measurement}" Style="{StaticResource MutedText}" />
                    <TextBlock Text="{Binding Evidence}" FontSize="12" />
                    <Button Content="{Binding Action}" Command="{Binding DataContext.Open,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Destination}" HorizontalAlignment="Left" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </DataTemplate>
      <DataTemplate x:Key="Page-Optimizations">
        <StackPanel Tag="Page-Optimizations" DataContext="{Binding DataContext,RelativeSource={RelativeSource AncestorType=Window}}">
          <TextBlock Text="FIND AN ADJUSTMENT" Style="{StaticResource Eyebrow}" />
          <Grid Margin="0,0,0,4">
            <TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search optimizations" Padding="38,10,12,10"/>
            <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{DynamicResource Muted}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,14,0,0" IsHitTestVisible="False"/>
            <TextBlock Text="Search settings, categories, or features…" Foreground="{DynamicResource Muted}" Margin="40,11,16,0" VerticalAlignment="Top" IsHitTestVisible="False">
              <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
          </Grid>
          <WrapPanel>
            <ComboBox Width="150" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" AutomationProperties.Name="Category filter" />
            <ComboBox Width="170" ItemsSource="{Binding ApplicabilityOptions}" SelectedItem="{Binding Applicability}" AutomationProperties.Name="Compatibility filter" />
            <ComboBox Width="132" ItemsSource="{Binding Risks}" SelectedItem="{Binding Risk}" AutomationProperties.Name="Risk filter" />
            <ComboBox Width="150" ItemsSource="{Binding StateOptions}" SelectedItem="{Binding CurrentState}" AutomationProperties.Name="Current value filter" />
            <ComboBox Width="170" ItemsSource="{Binding RestartOptions}" SelectedItem="{Binding Restart}" AutomationProperties.Name="Restart filter" />
          </WrapPanel>
          <ItemsControl ItemsSource="{Binding FilteredOperations}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><local:AdaptivePanel MinimumItemWidth="310" MaxColumns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Heading}" />
                    <TextBlock Text="{Binding Meta}" Style="{StaticResource MutedText}" FontSize="12" />
                    <TextBlock Text="{Binding Purpose}" />
                    <TextBlock>
                      <Run Text="Current: " />
                      <Run Text="{Binding Current,Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding Compatibility}" Style="{StaticResource MutedText}" />
                    <WrapPanel>
                      <ComboBox MinWidth="160" MaxWidth="320" ItemsSource="{Binding Choices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Target}" AutomationProperties.Name="Proposed value" />
                      <Button Content="Stage change" Command="{Binding DataContext.Stage,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                    </WrapPanel>
                    <Expander Header="Evidence, tradeoffs and exact undo">
                      <StackPanel>
                        <TextBlock Text="{Binding Tradeoff}" />
                        <TextBlock>
                          <Run Text="Evidence: " />
                          <Run Text="{Binding Evidence,Mode=OneWay}" />
                          <Run Text=" · Recovery: " />
                          <Run Text="{Binding Recovery,Mode=OneWay}" />
                        </TextBlock>
                        <Button Content="Windows documentation" Command="{Binding DataContext.Open,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Definition.Documentation}" HorizontalAlignment="Left" />
                      </StackPanel>
                    </Expander>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="Windows controls and guidance" Style="{StaticResource Heading}" />
          <ItemsControl ItemsSource="{Binding Guides}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><local:AdaptivePanel MinimumItemWidth="290" MaxColumns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Heading}" />
                    <TextBlock Text="{Binding Type}" Foreground="{DynamicResource Accent}" FontSize="12" />
                    <TextBlock Text="{Binding Description}" />
                    <Button Content="{Binding Action}" Command="{Binding DataContext.Open,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Url}" HorizontalAlignment="Left" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </DataTemplate>
      <DataTemplate x:Key="Page-Profiles">
        <StackPanel Tag="Page-Profiles" DataContext="{Binding DataContext,RelativeSource={RelativeSource AncestorType=Window}}">
          <TextBlock Text="CHOOSE YOUR FOCUS" Style="{StaticResource Eyebrow}"/>
          <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding Profile}" ItemContainerStyle="{StaticResource ProfileTile}" AutomationProperties.Name="Workload profile" Margin="0,0,0,20" ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel><ItemsPanelTemplate><local:AdaptivePanel MinimumItemWidth="210" MaxColumns="3" Gap="12"/></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBox.ItemTemplate><DataTemplate>
              <StackPanel><TextBlock Text="{Binding Converter={StaticResource Presentation},ConverterParameter=Glyph}" Style="{StaticResource Glyph}" Foreground="{DynamicResource Accent}" FontSize="24" Margin="0,0,0,20"/><TextBlock Text="{Binding}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding Converter={StaticResource Presentation},ConverterParameter=ProfileDescription}" Style="{StaticResource MutedText}" FontSize="12" Margin="0"/></StackPanel>
            </DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <Border Style="{StaticResource Card}" Background="{DynamicResource Raised}">
            <StackPanel>
              <TextBlock Text="{Binding Profile,StringFormat={}{0} · your selected profile}" Style="{StaticResource Heading}"/>
              <TextBlock Text="{Binding Profile,Converter={StaticResource Presentation},ConverterParameter=ProfileDetail}" Style="{StaticResource MutedText}"/>
              <TextBlock Text="Only installed power plans are used. You'll see the exact changes before applying." Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,16"/>
              <Button Content="Stage this profile  →" Command="{Binding StageProfile}" Style="{StaticResource Primary}" HorizontalAlignment="Left" Margin="0"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Make it your own" Style="{StaticResource Heading}" />
              <TextBlock Text="Pick settings in Optimizations and save your combination. Import a profile whenever you want to use it again." Style="{StaticResource MutedText}"/>
              <WrapPanel>
                <Button Content="Import profile" Command="{Binding Import}" />
                <Button Content="Export staged profile" Command="{Binding Export}" />
              </WrapPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Just for this game" Style="{StaticResource Heading}" />
              <TextBlock Text="Choose a running game, then stage and preview your profile. EZoptimizer attempts exact undo when the game or app closes. Interrupted sessions stay in Recovery." Style="{StaticResource MutedText}" />
              <Button Content="Refresh running games and apps" Command="{Binding RefreshDiagnostics}" HorizontalAlignment="Left"/>
              <ComboBox ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedGame}" DisplayMemberPath="Display" AutomationProperties.Name="Selected running game" />
              <Button Content="Start reviewed game session" Command="{Binding StartGame}" HorizontalAlignment="Left" />
            </StackPanel>
          </Border>
        </StackPanel>
      </DataTemplate>
      <DataTemplate x:Key="Page-Diagnostics">
        <StackPanel Tag="Page-Diagnostics" DataContext="{Binding DataContext,RelativeSource={RelativeSource AncestorType=Window}}">
          <WrapPanel>
            <Button Content="Refresh inventories" Command="{Binding RefreshDiagnostics}" Style="{StaticResource Primary}" />
            <Button Content="Review export" Command="{Binding ExportReport}" />
          </WrapPanel>
          <TextBlock Text="Read-only inventories. Protected processes and packages may be absent; no app is automatically marked unnecessary." Style="{StaticResource MutedText}" />
          <Expander Header="Processes · accessible working sets">
            <ListBox ItemsSource="{Binding Processes}" DisplayMemberPath="Display" Height="240" AutomationProperties.Name="Accessible processes" />
          </Expander>
          <Expander Header="Startup · Run keys and startup folders">
            <StackPanel>
              <ListBox ItemsSource="{Binding Startup}" Height="200" AutomationProperties.Name="Partial startup inventory" />
              <Button Content="Manage startup in Windows" Command="{Binding Open}" CommandParameter="ms-settings:startupapps" />
            </StackPanel>
          </Expander>
          <Expander Header="Registered applications · user and machine scopes">
            <StackPanel>
              <ListBox ItemsSource="{Binding Apps}" DisplayMemberPath="Display" Height="240" AutomationProperties.Name="Registered applications" />
              <TextBlock Text="Partial uninstall-registry inventory. Framework/provisioned-package classification and removal are deferred. Windows provides the item-specific uninstall workflow; user data may be lost." />
              <Button Content="Open Windows installed apps" Command="{Binding Open}" CommandParameter="ms-settings:appsfeatures" />
            </StackPanel>
          </Expander>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Network · adapters and configured DNS" Style="{StaticResource Heading}" />
              <TextBlock Text="{Binding Network}" Style="{StaticResource MutedText}" />
              <TextBlock Text="Endpoint hostname or IP · five ICMP requests only when you click" />
              <TextBox Text="{Binding Endpoint,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Endpoint hostname or IP" />
              <Button Content="Measure selected endpoint" Command="{Binding MeasureNetwork}" HorizontalAlignment="Left" />
              <TextBlock Text="{Binding NetworkResult}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Before / after · repeatable workload" Style="{StaticResource Heading}" />
              <TextBox Text="{Binding Workload}" AutomationProperties.Name="Workload context" />
              <Button Content="Collect baseline / comparison" Command="{Binding Compare}" HorizontalAlignment="Left" />
              <TextBlock Text="{Binding Comparison}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </DataTemplate>
      <DataTemplate x:Key="Page-Recovery &amp; History">
        <StackPanel Tag="Page-Recovery &amp; History" DataContext="{Binding DataContext,RelativeSource={RelativeSource AncestorType=Window}}">
          <TextBlock Text="{Binding RecoverySummary}" Style="{StaticResource MutedText}" />
          <TextBlock Text="Review past sessions or restore your original preferences. Settings changed elsewhere are kept for your review." Style="{StaticResource MutedText}" Margin="0,0,0,20"/>
          <Border Padding="32" Margin="0,0,0,20" Background="{DynamicResource Surface}" CornerRadius="14" BorderBrush="{DynamicResource Line}" BorderThickness="1">
            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding History.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
            <StackPanel HorizontalAlignment="Center"><TextBlock Text="&#xE81C;" Style="{StaticResource Glyph}" Foreground="{DynamicResource Accent}" FontSize="30" HorizontalAlignment="Center" Margin="0,0,0,18"/><TextBlock Text="A clean slate" Style="{StaticResource Heading}" TextAlignment="Center"/><TextBlock Text="Your reviewed changes will appear here, with their original values and recovery details." Style="{StaticResource MutedText}" TextAlignment="Center" MaxWidth="360"/><Button Content="Explore profiles  →" Command="{Binding Navigate}" CommandParameter="Profiles" Style="{StaticResource Primary}" HorizontalAlignment="Center" Margin="0,12,0,0"/></StackPanel>
          </Border>
          <ItemsControl ItemsSource="{Binding History}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="{Binding Profile}" Style="{StaticResource Heading}" />
                    <TextBlock>
                      <Run Text="{Binding CreatedUtc,Mode=OneWay}" />
                      <Run Text=" · " />
                      <Run Text="{Binding Status,Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding Id}" Style="{StaticResource MutedText}" FontSize="11" />
                    <Expander Header="Operation results">
                      <ItemsControl ItemsSource="{Binding Operations}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <StackPanel Margin="8">
                              <TextBlock>
                                <Run Text="{Binding Id,Mode=OneWay}" />
                                <Run Text=" · " />
                                <Run Text="{Binding State,Mode=OneWay}" />
                              </TextBlock>
                              <TextBlock>
                                <Run Text="{Binding Before,Mode=OneWay}" />
                                <Run Text=" → " />
                                <Run Text="{Binding Target,Mode=OneWay}" />
                              </TextBlock>
                              <TextBlock Text="{Binding Result}" Style="{StaticResource MutedText}" />
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Expander>
                    <Button Content="Undo / retry exact restoration" Command="{Binding DataContext.Undo,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" HorizontalAlignment="Left" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Expander Header="Recovery help"><TextBlock Text="Unreadable records are kept separately so valid sessions can still be restored. To open without dashboard probes, launch EZoptimizer.exe --recovery." Style="{StaticResource MutedText}"/></Expander>
        </StackPanel>
      </DataTemplate>
      <DataTemplate x:Key="Page-Settings">
        <StackPanel Tag="Page-Settings" DataContext="{Binding DataContext,RelativeSource={RelativeSource AncestorType=Window}}">
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Appearance and session" Style="{StaticResource Heading}" />
              <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" AutomationProperties.Name="Color theme" />
              <TextBlock Text="Windows high contrast takes precedence. No interface animations. Windows DPI scaling is supported; all pages scroll at small sizes." />
              <CheckBox Content="Keep this PC awake while EZoptimizer is open" IsChecked="{Binding KeepAwake}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="System Restore · supplementary" Style="{StaticResource Heading}" />
              <TextBlock Text="{Binding RestoreStatus}" />
              <WrapPanel>
                <Button Content="Inspect availability" Command="{Binding InspectRestore}" />
                <Button Content="Review restore-point creation" Command="{Binding CreateRestore}" />
                <Button Content="System Protection" Command="{Binding Open}" CommandParameter="protection" />
                <Button Content="Open Windows recovery" Command="{Binding Open}" CommandParameter="restore" />
              </WrapPanel>
              <TextBlock Text="Not a backup of personal files. The three preference controls use exact journals and do not require a restore point." Style="{StaticResource MutedText}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Updates · official releases" Style="{StaticResource Heading}" />
              <CheckBox Content="Include preview releases" IsChecked="{Binding PreviewChannel}" />
              <WrapPanel>
                <Button Content="Check for updates" Command="{Binding CheckUpdate}" />
                <Button Content="Open official release page" Command="{Binding Open}" CommandParameter="https://github.com/eyad1dk/EZoptimizer/releases" />
              </WrapPanel>
              <TextBlock Text="{Binding UpdateStatus}" />
              <TextBlock Text="Installation remains manual until publisher signing exists. A neighboring checksum checks integrity, not publisher identity. This preview is unsigned." Style="{StaticResource MutedText}" />
            </StackPanel>
          </Border>
          <TextBlock Text="No telemetry, account, background service or automatic uploads. Logs stay local with redacted operation results. Review reports before saving." />
        </StackPanel>
      </DataTemplate>
    </ResourceDictionary>
  </Window.Resources>
  <Grid x:Name="Root" Background="{DynamicResource Canvas}">
    <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="{Binding ActualWidth,ElementName=Root,Converter={StaticResource Presentation},ConverterParameter=RailWidth}" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border Grid.ColumnSpan="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Style="{StaticResource WindowButton}" Content="&#xE921;" Click="MinimizeWindow" AutomationProperties.Name="Minimize window" ToolTip="Minimize"/>
          <Button Style="{StaticResource WindowButton}" Content="&#xE922;" Click="MaximizeWindow" AutomationProperties.Name="Maximize or restore window" ToolTip="Maximize or restore"/>
          <Button Style="{StaticResource WindowButton}" Content="&#xE8BB;" Click="CloseWindow" AutomationProperties.Name="Close window" ToolTip="Close"/>
        </StackPanel>
        <TextBlock Text="EZoptimizer  /  Your workspace" FontSize="10" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="22,0,0,0"/>
      </DockPanel>
    </Border>
    <Border Grid.Row="1" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
      <DockPanel Margin="12,24,12,16">
        <StackPanel DockPanel.Dock="Top" Margin="4,0,4,28">
          <StackPanel Orientation="Horizontal">
            <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource Accent}" VerticalAlignment="Center">
              <Path Data="M 16,2 L 5,16 L 12,16 L 8,27 L 23,11 L 15,11 Z" Fill="{DynamicResource OnAccent}" Stretch="Uniform" Width="16" Height="23"/>
            </Border>
            <StackPanel Margin="10,0,0,0" Visibility="{Binding ActualWidth,ElementName=Root,Converter={StaticResource Presentation},ConverterParameter=RailLabel}">
              <TextBlock Text="EZoptimizer" FontSize="18" LineHeight="24" FontWeight="SemiBold" Margin="0"/>
              <TextBlock Text="A little tuning. A better day." FontSize="9" Foreground="{DynamicResource Muted}" Margin="0" LineHeight="14"/>
            </StackPanel>
          </StackPanel>
        </StackPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="4,16,4,0">
          <StackPanel>
            <TextBlock Text="v0.2.1" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0"/>
            <TextBlock Text="PREVIEW · LOCAL BY DESIGN" FontSize="9" Foreground="{DynamicResource Muted}" Margin="0" Visibility="{Binding ActualWidth,ElementName=Root,Converter={StaticResource Presentation},ConverterParameter=RailLabel}"/>
          </StackPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
          <TextBlock Text="WORKSPACE" Style="{StaticResource Eyebrow}" Margin="12,0,0,8" Visibility="{Binding ActualWidth,ElementName=Root,Converter={StaticResource Presentation},ConverterParameter=RailLabel}"/>
          <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding Page}" AutomationProperties.Name="Navigation" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate><DataTemplate><Grid ToolTip="{Binding}" AutomationProperties.Name="{Binding}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Converter={StaticResource Presentation},ConverterParameter=Glyph}" Style="{StaticResource Glyph}" FontSize="16"/>
              <TextBlock Grid.Column="1" Text="{Binding Converter={StaticResource Presentation},ConverterParameter=NavTitle}" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding Content.ActualWidth,RelativeSource={RelativeSource AncestorType=Window},Converter={StaticResource Presentation},ConverterParameter=RailLabel}"/>
            </Grid></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
        </StackPanel></ScrollViewer>
      </DockPanel>
    </Border>
    <DockPanel Grid.Row="1" Grid.Column="1" Margin="28,24,24,16">
      <Border MaxHeight="{Binding ActualHeight,ElementName=Root,Converter={StaticResource Presentation},ConverterParameter=QueueHeight}" DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="14,6" Background="{DynamicResource Surface}" Margin="0,12,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock x:Name="OperationStatus" Text="{Binding Status}" AutomationProperties.Name="Operation status" AutomationProperties.LiveSetting="Polite" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0"/>
            <Expander IsExpanded="{Binding QueueExpanded}" Header="{Binding QueueTitle}" AutomationProperties.Name="Persistent review queue" FontSize="12" Margin="0">
              <StackPanel>
                <ScrollViewer MaxHeight="96">
                  <ItemsControl ItemsSource="{Binding Review}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Padding="8" Background="{DynamicResource Surface}" Margin="0,0,0,4">
                          <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            <TextBlock>
                              <Run Text="{Binding Before,Mode=OneWay}" />
                              <Run Text=" → " />
                              <Run Text="{Binding After,Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Contract}" Style="{StaticResource MutedText}" FontSize="12" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <WrapPanel>
                  <Button Content="Preview exact changes" Command="{Binding Preview}" />
                  <Button Content="Apply reviewed changes" Command="{Binding Apply}" Style="{StaticResource Primary}" />
                  <Button Content="Cancel batch" Command="{Binding Cancel}" />
                  <Button Content="Clear queue" Command="{Binding Clear}" />
                </WrapPanel>
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </Border>
      <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <TextBlock Text="YOUR WORKSPACE" Style="{StaticResource Eyebrow}" Margin="0,0,0,6"/>
          <TextBlock Text="{Binding Page}" Style="{StaticResource Title}" />
          <TextBlock Text="{Binding Page,Converter={StaticResource Presentation},ConverterParameter=Subtitle}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,24"/>
          <ContentControl Content="{Binding Page}" ContentTemplateSelector="{StaticResource NavigationTemplate}" Margin="0,0,8,0"/>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Grid>
</Window>
