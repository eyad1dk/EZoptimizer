<Window x:Class="ForgePC.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="EZoptimizer" Width="1180" Height="850" MinWidth="980" MinHeight="650" Background="#0B1220" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen">
 <Grid Background="#0B1220">
  <Grid.ColumnDefinitions><ColumnDefinition Width="215"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#101A2C" Padding="22,30">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top">
     <TextBlock Text="EZ" FontSize="34" FontWeight="Bold" Foreground="#60E4C3"/>
     <TextBlock Text="optimizer" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <TextBlock Text="Make room for what matters." Foreground="{StaticResource Muted}" Margin="0,0,0,36"/>
     <Button Content="Overview" Tag="Overview" Click="Navigate"/>
     <Button Content="Profiles" Tag="Profiles" Click="Navigate"/>
     <Button Content="Processes &amp; startup" Tag="Inspect" Click="Navigate"/>
     <Button Content="Windows tools" Tag="Tools" Click="Navigate"/>
     <Button Content="History &amp; undo" Tag="History" Click="Navigate"/>
    </StackPanel>
    <StackPanel VerticalAlignment="Bottom">
     <TextBlock Text="YOUR PC. YOUR CALL." FontSize="11" Foreground="#60E4C3" Margin="0,0,0,8"/>
     <TextBlock Text="Local. Open source.&#10;Every change explained." Foreground="{StaticResource Muted}"/>
     <TextBlock Text="v0.1.0 · Preview" Foreground="{StaticResource Muted}" Margin="0,18,0,0"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="30,26,18,20">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,14,24"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PageTitle" Text="Your PC, at a glance." FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="Real readings. Clear choices. No magic numbers." Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel><TextBlock Grid.Column="1" x:Name="LiveIndicator" Text="● LIVE" Foreground="#60E4C3" VerticalAlignment="Center"/></Grid>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
    <StackPanel>
     <StackPanel x:Name="OverviewPage">
      <UniformGrid Columns="3">
       <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="PROCESSOR" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="CpuValue" Text="—" FontSize="34" Margin="0,12,0,10"/><ProgressBar x:Name="CpuBar" Height="5" Foreground="#60E4C3" Background="#28344A"/><TextBlock x:Name="CpuDetail" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,14,0,0"/></StackPanel></Border>
       <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="MEMORY" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="RamValue" Text="—" FontSize="34" Margin="0,12,0,10"/><ProgressBar x:Name="RamBar" Height="5" Foreground="#83ABFF" Background="#28344A"/><TextBlock x:Name="RamDetail" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,14,0,0"/></StackPanel></Border>
       <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="SYSTEM DRIVE" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="DiskValue" Text="—" FontSize="34" Margin="0,12,0,10"/><ProgressBar x:Name="DiskBar" Height="5" Foreground="#E4BB73" Background="#28344A"/><TextBlock x:Name="DiskDetail" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,14,0,0"/></StackPanel></Border>
      </UniformGrid>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Tune for your next session." FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Pick a profile, review the exact changes, then apply. Your previous settings are saved first." Foreground="{StaticResource Muted}" Margin="0,10,0,20"/><WrapPanel><Button Content="Gaming →" Tag="Gaming" Click="ChooseProfile" Background="#2E7668"/><Button Content="Coding →" Tag="Coding" Click="ChooseProfile"/><Button Content="Everyday →" Tag="Everyday" Click="ChooseProfile"/><Button Content="Quiet →" Tag="Quiet" Click="ChooseProfile"/></WrapPanel></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="What deserves your attention?" FontSize="19"/><TextBlock x:Name="Advice" Foreground="{StaticResource Muted}" Margin="0,12,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Keep a long build awake." FontSize="19"/><TextBlock Text="Temporarily prevent idle sleep while EZoptimizer is open. The screen can still turn off. Closing the app releases the request." Foreground="{StaticResource Muted}" Margin="0,10,0,8"/><CheckBox x:Name="Awake" Content="Keep this PC awake for my session" Click="ToggleAwake"/></StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="ProfilesPage" Visibility="Collapsed">
      <WrapPanel><Button Content="Gaming" Tag="Gaming" Click="ChooseProfile"/><Button Content="Coding" Tag="Coding" Click="ChooseProfile"/><Button Content="Everyday" Tag="Everyday" Click="ChooseProfile"/><Button Content="Quiet" Tag="Quiet" Click="ChooseProfile"/></WrapPanel>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="ProfileName" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="ProfileDescription" Foreground="{StaticResource Muted}" Margin="0,10,0,18"/>
       <TextBlock Text="POWER PLAN" Foreground="{StaticResource Muted}" FontSize="11"/><ComboBox x:Name="PlanPicker" Margin="0,8,0,8" Padding="10" AutomationProperties.Name="Power plan"/>
       <TextBlock Text="Only plans already installed on this PC appear here. High performance can increase heat, fan noise and battery use; it may not improve your workload." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,12"/>
       <CheckBox x:Name="Animations" Content="Enable animations inside Windows apps"/>
       <CheckBox x:Name="Menus" Content="Enable Windows menu animations"/>
       <TextBlock Text="Animation changes affect how Windows feels. They are not an FPS boost. Apps can choose whether to follow these preferences." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,18"/>
       <Button Content="Preview changes" Click="PreviewChanges" HorizontalAlignment="Left" Background="#2E7668"/>
      </StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Review before applying" FontSize="20"/><TextBlock x:Name="PreviewText" Text="Your current settings are untouched. Choose your options and preview them." Foreground="{StaticResource Muted}" Margin="0,14,0,18"/><Button x:Name="ApplyButton" Content="Apply reviewed changes" Click="ApplyChanges" IsEnabled="False" HorizontalAlignment="Left" Background="#2E7668"/></StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="InspectPage" Visibility="Collapsed">
      <WrapPanel><Button Content="Refresh lists" Click="RefreshLists"/><Button Content="Manage startup in Windows" Tag="ms-settings:startupapps" Click="OpenTool"/></WrapPanel>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Largest processes by memory" FontSize="20"/><TextBlock Text="Working set, refreshed on request. Windows shares some memory between processes, so these values should not be added together." Foreground="{StaticResource Muted}" Margin="0,8,0,16"/><TextBlock x:Name="ProcessList" FontFamily="Consolas" FontSize="13"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Startup entries" FontSize="20"/><TextBlock Text="Run keys and startup folders. This is a partial inventory; Windows Settings also includes packaged apps and enable/disable controls." Foreground="{StaticResource Muted}" Margin="0,8,0,16"/><TextBlock x:Name="StartupList" FontSize="13"/></StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="ToolsPage" Visibility="Collapsed">
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Gaming setup" FontSize="20"/><TextBlock Text="Review Game Mode, background recording and per-app graphics preferences using Windows' own controls." Foreground="{StaticResource Muted}" Margin="0,8,0,16"/><WrapPanel><Button Content="Game Mode" Tag="ms-settings:gaming-gamemode" Click="OpenTool"/><Button Content="Captures" Tag="ms-settings:gaming-gamedvr" Click="OpenTool"/><Button Content="Graphics settings" Tag="ms-settings:display-advancedgraphics" Click="OpenTool"/></WrapPanel></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Space &amp; maintenance" FontSize="20"/><TextBlock Text="Review files in Windows before deleting them. Keep your updates and protection current." Foreground="{StaticResource Muted}" Margin="0,8,0,16"/><WrapPanel><Button Content="Storage cleanup" Tag="ms-settings:storagesense" Click="OpenTool"/><Button Content="Windows Update" Tag="ms-settings:windowsupdate" Click="OpenTool"/><Button Content="Windows Security" Tag="windowsdefender:" Click="OpenTool"/></WrapPanel></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Development &amp; everyday work" FontSize="20"/><TextBlock Text="Control notifications, review installed tools, and choose when your PC sleeps." Foreground="{StaticResource Muted}" Margin="0,8,0,16"/><WrapPanel><Button Content="Notifications" Tag="ms-settings:notifications" Click="OpenTool"/><Button Content="Installed apps" Tag="ms-settings:appsfeatures" Click="OpenTool"/><Button Content="Power &amp; sleep" Tag="ms-settings:powersleep" Click="OpenTool"/></WrapPanel></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Export a system report" FontSize="20"/><TextBlock Text="Includes CPU model, memory, disk capacity, OS version and current tuning settings. No usernames, file paths or process names. Review before sharing." Foreground="{StaticResource Muted}" Margin="0,8,0,16"/><Button Content="Save report…" Click="ExportReport" HorizontalAlignment="Left"/></StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="HistoryPage" Visibility="Collapsed">
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Your way back." FontSize="23"/><TextBlock Text="Undo restores the values saved before your last session. If a setting has since changed elsewhere, EZoptimizer leaves it alone and tells you what to review. Undo the current session before applying another." Foreground="{StaticResource Muted}" Margin="0,12,0,20"/><Button Content="Undo session" Click="Undo" HorizontalAlignment="Left" Background="#2E7668"/><TextBlock x:Name="HistoryText" Margin="0,14,0,0" Foreground="{StaticResource Muted}"/></StackPanel></Border>
     </StackPanel>
    </StackPanel>
   </ScrollViewer>
   <Border Grid.Row="2" Background="#101A2C" CornerRadius="8" Padding="14,10" Margin="0,10,14,0"><TextBlock x:Name="Status" Text="Ready. Choose a profile to get started." Foreground="{StaticResource Muted}"/></Border>
  </Grid>
 </Grid>
</Window>
