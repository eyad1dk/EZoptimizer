<Window x:Class="ForgePC.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="EZoptimizer" Width="1180" Height="840" MinWidth="640" MinHeight="360" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <ResourceDictionary>
      <local:NavigationTemplateSelector x:Key="NavigationTemplate" xmlns:local="clr-namespace:ForgePC" />
      <DataTemplate x:Key="Page-Overview">
        <StackPanel Tag="Page-Overview" DataContext="{Binding DataContext,RelativeSource={RelativeSource AncestorType=Window}}">
          <TextBlock Text="Your PC, with the details that matter." Style="{StaticResource MutedText}" />
          <TextBlock Text="{Binding Stamp}" Style="{StaticResource MutedText}" FontSize="12" />
          <WrapPanel>
            <Border Style="{StaticResource Card}" Width="224" Margin="0,0,16,16">
              <StackPanel>
                <TextBlock Text="CPU · sampled utilization" Style="{StaticResource MutedText}" />
                <TextBlock Text="{Binding Cpu}" FontSize="32" FontWeight="SemiBold" />
                <Polyline Points="{Binding CpuPoints}" Stroke="{DynamicResource Accent}" StrokeThickness="2" Height="44" Width="200" Stretch="None" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Width="224" Margin="0,0,16,16">
              <StackPanel>
                <TextBlock Text="Physical memory · in use" Style="{StaticResource MutedText}" />
                <TextBlock Text="{Binding Memory}" FontSize="32" FontWeight="SemiBold" />
                <Polyline Points="{Binding MemoryPoints}" Stroke="{DynamicResource Accent}" StrokeThickness="2" Height="44" Width="200" Stretch="None" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Width="224">
              <StackPanel>
                <TextBlock Text="System drive · free" Style="{StaticResource MutedText}" />
                <TextBlock Text="{Binding Disk}" FontSize="32" FontWeight="SemiBold" />
                <TextBlock Text="Windows-managed cleanup" Style="{StaticResource MutedText}" />
              </StackPanel>
            </Border>
          </WrapPanel>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Recovery comes first" Style="{StaticResource Heading}" />
              <TextBlock Text="{Binding RecoverySummary}" />
              <TextBlock>
                <Run Text="Active profile: " />
                <Run Text="{Binding ActiveProfile,Mode=OneWay}" />
              </TextBlock>
              <WrapPanel>
                <Button Content="Review profiles" Command="{Binding Navigate}" CommandParameter="Profiles" Style="{StaticResource Primary}" />
                <Button Content="Open recovery" Command="{Binding Navigate}" CommandParameter="Recovery &amp; History" />
              </WrapPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Hardware at a glance" Style="{StaticResource Heading}" />
              <TextBlock Text="{Binding Hardware}" Style="{StaticResource MutedText}" />
            </StackPanel>
          </Border>
          <Button HorizontalAlignment="Left" Content="See explained recommendations" Command="{Binding Navigate}" CommandParameter="Recommendations" />
        </StackPanel>
      </DataTemplate>
      <DataTemplate x:Key="Page-Recommendations">
        <StackPanel Tag="Page-Recommendations" DataContext="{Binding DataContext,RelativeSource={RelativeSource AncestorType=Window}}">
          <TextBlock Text="Recommendations explain their evidence. No score or guaranteed gain." Style="{StaticResource MutedText}" />
          <ItemsControl ItemsSource="{Binding Recommendations}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Heading}" />
                    <TextBlock Text="{Binding Detected}" Foreground="{DynamicResource Accent}" />
                    <TextBlock Text="{Binding Reason}" />
                    <TextBlock Text="{Binding Measurement}" Style="{StaticResource MutedText}" />
                    <TextBlock Text="{Binding Evidence}" FontSize="12" />
                    <Button Content="{Binding Action}" Command="{Binding DataContext.Open,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Destination}" HorizontalAlignment="Left" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </DataTemplate>
      <DataTemplate x:Key="Page-Optimizations">
        <StackPanel Tag="Page-Optimizations" DataContext="{Binding DataContext,RelativeSource={RelativeSource AncestorType=Window}}">
          <TextBlock Text="Pick a setting, stage it, then preview. Shortcuts open Windows without changing anything here." Style="{StaticResource MutedText}" />
          <TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search optimizations" />
          <WrapPanel>
            <ComboBox Width="150" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" AutomationProperties.Name="Category filter" />
            <ComboBox Width="170" ItemsSource="{Binding ApplicabilityOptions}" SelectedItem="{Binding Applicability}" AutomationProperties.Name="Compatibility filter" />
            <ComboBox Width="132" ItemsSource="{Binding Risks}" SelectedItem="{Binding Risk}" AutomationProperties.Name="Risk filter" />
            <ComboBox Width="150" ItemsSource="{Binding StateOptions}" SelectedItem="{Binding CurrentState}" AutomationProperties.Name="Current value filter" />
            <ComboBox Width="170" ItemsSource="{Binding RestartOptions}" SelectedItem="{Binding Restart}" AutomationProperties.Name="Restart filter" />
          </WrapPanel>
          <ItemsControl ItemsSource="{Binding FilteredOperations}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Heading}" />
                    <TextBlock Text="{Binding Meta}" Style="{StaticResource MutedText}" FontSize="12" />
                    <TextBlock Text="{Binding Purpose}" />
                    <TextBlock>
                      <Run Text="Current: " />
                      <Run Text="{Binding Current,Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding Compatibility}" Style="{StaticResource MutedText}" />
                    <WrapPanel>
                      <ComboBox MinWidth="160" MaxWidth="320" ItemsSource="{Binding Choices}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Target}" AutomationProperties.Name="Proposed value" />
                      <Button Content="Stage change" Command="{Binding DataContext.Stage,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                    </WrapPanel>
                    <Expander Header="Evidence, tradeoffs and exact undo">
                      <StackPanel>
                        <TextBlock Text="{Binding Tradeoff}" />
                        <TextBlock>
                          <Run Text="Evidence: " />
                          <Run Text="{Binding Evidence,Mode=OneWay}" />
                          <Run Text=" · Recovery: " />
                          <Run Text="{Binding Recovery,Mode=OneWay}" />
                        </TextBlock>
                        <Button Content="Windows documentation" Command="{Binding DataContext.Open,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Definition.Documentation}" HorizontalAlignment="Left" />
                      </StackPanel>
                    </Expander>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="Windows controls and guidance" Style="{StaticResource Heading}" />
          <ItemsControl ItemsSource="{Binding Guides}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Heading}" />
                    <TextBlock Text="{Binding Type}" Foreground="{DynamicResource Accent}" FontSize="12" />
                    <TextBlock Text="{Binding Description}" />
                    <Button Content="{Binding Action}" Command="{Binding DataContext.Open,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Url}" HorizontalAlignment="Left" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </DataTemplate>
      <DataTemplate x:Key="Page-Profiles">
        <StackPanel Tag="Page-Profiles" DataContext="{Binding DataContext,RelativeSource={RelativeSource AncestorType=Window}}">
          <TextBlock Text="A starting point for your workflow. Presets do not promise FPS or faster builds." Style="{StaticResource MutedText}" />
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Conservative presets" Style="{StaticResource Heading}" />
              <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding Profile}" AutomationProperties.Name="Workload profile" />
              <TextBlock Text="Gaming / Coding: reduced animations and Balanced. Everyday: animations on and Balanced. Quiet / Battery Saver: reduced animations and installed Power saver. Missing plans are skipped." />
              <Button Content="Stage profile for review" Command="{Binding StageProfile}" Style="{StaticResource Primary}" HorizontalAlignment="Left" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Your own profile" Style="{StaticResource Heading}" />
              <TextBlock Text="Stage individual settings in Optimizations, then export that desired configuration. Imports contain allowlisted values only. Originals come from this PC during preview." />
              <WrapPanel>
                <Button Content="Import profile" Command="{Binding Import}" />
                <Button Content="Export staged profile" Command="{Binding Export}" />
              </WrapPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Opt-in game session" Style="{StaticResource Heading}" />
              <TextBlock Text="Select an already running game from Diagnostics. Stage and preview a profile. Exact undo runs on game exit or normal app exit. A crash leaves its journal for recovery. No injection, launch or forced closure." />
              <ComboBox ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedGame}" DisplayMemberPath="Display" AutomationProperties.Name="Selected running game" />
              <Button Content="Start reviewed game session" Command="{Binding StartGame}" HorizontalAlignment="Left" />
            </StackPanel>
          </Border>
        </StackPanel>
      </DataTemplate>
      <DataTemplate x:Key="Page-Diagnostics">
        <StackPanel Tag="Page-Diagnostics" DataContext="{Binding DataContext,RelativeSource={RelativeSource AncestorType=Window}}">
          <WrapPanel>
            <Button Content="Refresh inventories" Command="{Binding RefreshDiagnostics}" Style="{StaticResource Primary}" />
            <Button Content="Review export" Command="{Binding ExportReport}" />
          </WrapPanel>
          <TextBlock Text="Read-only inventories. Protected processes and packages may be absent; no app is automatically marked unnecessary." Style="{StaticResource MutedText}" />
          <Expander Header="Processes · accessible working sets">
            <ListBox ItemsSource="{Binding Processes}" DisplayMemberPath="Display" Height="240" AutomationProperties.Name="Accessible processes" />
          </Expander>
          <Expander Header="Startup · Run keys and startup folders">
            <StackPanel>
              <ListBox ItemsSource="{Binding Startup}" Height="200" AutomationProperties.Name="Partial startup inventory" />
              <Button Content="Manage startup in Windows" Command="{Binding Open}" CommandParameter="ms-settings:startupapps" />
            </StackPanel>
          </Expander>
          <Expander Header="Registered applications · user and machine scopes">
            <StackPanel>
              <ListBox ItemsSource="{Binding Apps}" DisplayMemberPath="Display" Height="240" AutomationProperties.Name="Registered applications" />
              <TextBlock Text="Partial uninstall-registry inventory. Framework/provisioned-package classification and removal are deferred. Windows provides the item-specific uninstall workflow; user data may be lost." />
              <Button Content="Open Windows installed apps" Command="{Binding Open}" CommandParameter="ms-settings:appsfeatures" />
            </StackPanel>
          </Expander>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Network · adapters and configured DNS" Style="{StaticResource Heading}" />
              <TextBlock Text="{Binding Network}" Style="{StaticResource MutedText}" />
              <TextBlock Text="Endpoint hostname or IP · five ICMP requests only when you click" />
              <TextBox Text="{Binding Endpoint,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Endpoint hostname or IP" />
              <Button Content="Measure selected endpoint" Command="{Binding MeasureNetwork}" HorizontalAlignment="Left" />
              <TextBlock Text="{Binding NetworkResult}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Before / after · repeatable workload" Style="{StaticResource Heading}" />
              <TextBox Text="{Binding Workload}" AutomationProperties.Name="Workload context" />
              <Button Content="Collect baseline / comparison" Command="{Binding Compare}" HorizontalAlignment="Left" />
              <TextBlock Text="{Binding Comparison}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </DataTemplate>
      <DataTemplate x:Key="Page-Recovery &amp; History">
        <StackPanel Tag="Page-Recovery &amp; History" DataContext="{Binding DataContext,RelativeSource={RelativeSource AncestorType=Window}}">
          <TextBlock Text="{Binding RecoverySummary}" Style="{StaticResource MutedText}" />
          <TextBlock Text="Undo preserves values changed outside EZoptimizer. Conflicts remain available for review and retry; there is no force-default reset." />
          <ItemsControl ItemsSource="{Binding History}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="{Binding Profile}" Style="{StaticResource Heading}" />
                    <TextBlock>
                      <Run Text="{Binding CreatedUtc,Mode=OneWay}" />
                      <Run Text=" · " />
                      <Run Text="{Binding Status,Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding Id}" Style="{StaticResource MutedText}" FontSize="11" />
                    <Expander Header="Operation results">
                      <ItemsControl ItemsSource="{Binding Operations}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <StackPanel Margin="8">
                              <TextBlock>
                                <Run Text="{Binding Id,Mode=OneWay}" />
                                <Run Text=" · " />
                                <Run Text="{Binding State,Mode=OneWay}" />
                              </TextBlock>
                              <TextBlock>
                                <Run Text="{Binding Before,Mode=OneWay}" />
                                <Run Text=" → " />
                                <Run Text="{Binding Target,Mode=OneWay}" />
                              </TextBlock>
                              <TextBlock Text="{Binding Result}" Style="{StaticResource MutedText}" />
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Expander>
                    <Button Content="Undo / retry exact restoration" Command="{Binding DataContext.Undo,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" HorizontalAlignment="Left" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="No saved cards means empty history. Malformed records are quarantined while valid journals remain recoverable. Launch EZoptimizer.exe --recovery to skip dashboard probes." />
        </StackPanel>
      </DataTemplate>
      <DataTemplate x:Key="Page-Settings">
        <StackPanel Tag="Page-Settings" DataContext="{Binding DataContext,RelativeSource={RelativeSource AncestorType=Window}}">
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Appearance and session" Style="{StaticResource Heading}" />
              <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" AutomationProperties.Name="Color theme" />
              <TextBlock Text="Windows high contrast takes precedence. No interface animations. Windows DPI scaling is supported; all pages scroll at small sizes." />
              <CheckBox Content="Keep this PC awake while EZoptimizer is open" IsChecked="{Binding KeepAwake}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="System Restore · supplementary" Style="{StaticResource Heading}" />
              <TextBlock Text="{Binding RestoreStatus}" />
              <WrapPanel>
                <Button Content="Inspect availability" Command="{Binding InspectRestore}" />
                <Button Content="Review restore-point creation" Command="{Binding CreateRestore}" />
                <Button Content="System Protection" Command="{Binding Open}" CommandParameter="protection" />
                <Button Content="Open Windows recovery" Command="{Binding Open}" CommandParameter="restore" />
              </WrapPanel>
              <TextBlock Text="Not a backup of personal files. The three preference controls use exact journals and do not require a restore point." Style="{StaticResource MutedText}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="Updates · official releases" Style="{StaticResource Heading}" />
              <CheckBox Content="Include preview releases" IsChecked="{Binding PreviewChannel}" />
              <WrapPanel>
                <Button Content="Check for updates" Command="{Binding CheckUpdate}" />
                <Button Content="Open official release page" Command="{Binding Open}" CommandParameter="https://github.com/eyad1dk/EZoptimizer/releases" />
              </WrapPanel>
              <TextBlock Text="{Binding UpdateStatus}" />
              <TextBlock Text="Installation remains manual until publisher signing exists. A neighboring checksum checks integrity, not publisher identity. This preview is unsigned." Style="{StaticResource MutedText}" />
            </StackPanel>
          </Border>
          <TextBlock Text="No telemetry, account, background service or automatic uploads. Logs stay local with redacted operation results. Review reports before saving." />
        </StackPanel>
      </DataTemplate>
    </ResourceDictionary>
  </Window.Resources>
  <Grid x:Name="Root" Background="{DynamicResource Canvas}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="176" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
      <DockPanel Margin="16,24,12,16">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="EZoptimizer" FontSize="20" FontWeight="Bold" />
          <TextBlock Text="MAKE IT YOURS" Foreground="{DynamicResource Accent}" FontSize="10" Margin="0,0,0,24" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="v0.2 preview&#xA;Local. Reviewed. Reversible." Style="{StaticResource MutedText}" FontSize="11" />
        <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding Page}" AutomationProperties.Name="Navigation" />
      </DockPanel>
    </Border>
    <DockPanel Grid.Column="1" Margin="24,20,24,16">
      <Border MaxHeight="216" DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock x:Name="OperationStatus" Text="{Binding Status}" AutomationProperties.Name="Operation status" AutomationProperties.LiveSetting="Polite" Style="{StaticResource MutedText}" />
            <Expander IsExpanded="{Binding QueueExpanded}" Header="{Binding QueueTitle}" AutomationProperties.Name="Persistent review queue">
              <StackPanel>
                <ScrollViewer MaxHeight="96">
                  <ItemsControl ItemsSource="{Binding Review}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Padding="8" Background="{DynamicResource Surface}" Margin="0,0,0,4">
                          <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            <TextBlock>
                              <Run Text="{Binding Before,Mode=OneWay}" />
                              <Run Text=" → " />
                              <Run Text="{Binding After,Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Contract}" Style="{StaticResource MutedText}" FontSize="12" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <WrapPanel>
                  <Button Content="Preview exact changes" Command="{Binding Preview}" />
                  <Button Content="Apply reviewed changes" Command="{Binding Apply}" Style="{StaticResource Primary}" />
                  <Button Content="Cancel batch" Command="{Binding Cancel}" />
                  <Button Content="Clear queue" Command="{Binding Clear}" />
                </WrapPanel>
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </Border>
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <TextBlock Text="{Binding Page}" Style="{StaticResource Title}" />
          <ContentControl Content="{Binding Page}" ContentTemplateSelector="{StaticResource NavigationTemplate}" />
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Grid>
</Window>